# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored; `.env.example` is committed so teammates know what is needed.

# --- Django (backend/django) -------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Where Django runs when it is the user-facing service.
DJANGO_BASE_URL=http://127.0.0.1:8000

# --- Shared between Django and FastAPI ---------------------------------------
# Both services sign and verify the same JWTs with this key (HS256). Django
# issues user access tokens and device tokens; FastAPI verifies them locally
# without calling Django, so the value must be identical on both sides.
# Neither service has a default: a missing key stops startup.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
JWT_SIGNING_KEY=change-me-shared-with-fastapi

# --- FastAPI (backend/fastapi) -----------------------------------------------
FASTAPI_ENV=development
# Async SQLAlchemy URL. Postgres uses the psycopg3 async driver; the test suite
# overrides this with sqlite+aiosqlite and TELEMETRY_SCHEMA="".
#   docker compose up -d postgres
DATABASE_URL=postgresql+psycopg://ecg:ecg@127.0.0.1:5432/ecg
# Everything FastAPI owns lives in this one schema (it creates it on migrate).
# Set to an empty value to run without a schema, e.g. on SQLite.
TELEMETRY_SCHEMA=telemetry
# A device is "online" if it was heard from within this many seconds.
HEARTBEAT_THRESHOLD_SECONDS=120
# Ingest guards.
MAX_PAYLOAD_BYTES=1048576
MAX_FUTURE_SECONDS=300
MAX_ECG_SAMPLES_PER_CHUNK=5000
# Comma-separated browser origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Django -> FastAPI session registry --------------------------------------
# Django pushes each new/stopped session here so FastAPI can reject data for
# unknown sessions without calling back. The push is best-effort: if FastAPI is
# down, session creation still succeeds.
TELEMETRY_BASE_URL=http://127.0.0.1:8001
TELEMETRY_SYNC_ENABLED=True
TELEMETRY_SYNC_TIMEOUT_SECONDS=2
